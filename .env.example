# Copia este archivo como .env (en la misma carpeta que manage.py) y llena los valores.
# Nunca subas el archivo .env a GitHub.

# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# En tu computadora: True. Al publicar: False.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Al publicar, pon aquí tu dominio con https, por ejemplo: https://mi-app.onrender.com
CSRF_TRUSTED_ORIGINS=
# Redes/IP de los proxies que controlas; vacío ignora X-Forwarded-For.
# Configura según la red real del despliegue. Nunca uses 0.0.0.0/0 ni ::/0.
TRUSTED_PROXY_CIDRS=

# Base de datos en línea (Neon). Vacía = SQLite local.
# Ejemplo: postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Inicio con Google (opcional). https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correos para recuperar contraseña (Brevo, gratis). https://app.brevo.com/settings/keys/api
# Sin BREVO_API_KEY los correos solo se muestran en la consola.
BREVO_API_KEY=
# Remitente verificado en Brevo (Senders) y nombre que verá el usuario
EMAIL_FROM=
EMAIL_FROM_NAME=Práctica ITM

# Dirección secreta del panel de administración (ej. panel-x7k2/)
ADMIN_URL=admin/

# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey  (respaldo; opcional pero recomendado)
GEMINI_API_KEY=

# Orden de modelos: si uno falla o se acaba la cuota, se usa el siguiente.
LLM_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash-lite
WHISPER_MODEL=whisper-large-v3-turbo

MESSAGES_PER_MINUTE=12
MESSAGES_PER_DAY=250
INTERVIEW_QUESTIONS=8
